# Cloudflare: HTTP-Header für die App (gilt auch für Worker mit statischen Dateien).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=()

# Service-Worker und Startseite nie zwischenspeichern, damit Updates ankommen.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
